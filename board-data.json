  "safetyLog": [
    {
      "date": "Jul 29, 2026",
      "shortDesc": "⚠️ PSE — dropped chain fall, 7HA.03 rigging (closed)",
      "desc": "7HA.03 exhaust frame rigging, July 29, 2026 — wire rope snagged and failed during rigging clearance, dropping a 10T chain fall to the turbine deck. No injuries. Investigation closed; corrective actions implemented (rigging clearance verification, secondary exclusion zone)."
    },
    {
      "date": "Jul 24, 2026",
      "shortDesc": "🛑 Stop Work — damaged sling caught before rotor lift",
      "desc": "7HA.03 Project Crew — Damaged sling discovered while unloading the rotor beam from the hook to the lifting beam. Sling immediately tagged out of service; no equivalent-rated sling available onsite, so a replacement was rented locally in Houston. Lift completed on schedule with no further delay."
    },
    {
      "date": "Jul 21, 2026",
      "shortDesc": "🛑 Recordable — fall, Birr stairwell",
      "desc": "Birr Learning Center, July 21, 2026 — employee fell on the stairs and sustained a torn Achilles tendon. Work-related, lost work time, recordable. Reminder: report incidents to EHS immediately — this one wasn't reported until nearly three weeks after it occurred."
    },
    {
      "date": "Jul 5, 2026",
      "shortDesc": "🛑 Stop Work — barricade correction, 7FH2 rotor",
      "desc": "Submitted by Ben Smith — LV 26-1 class was performing live electrical testing on the 7FH2 rotor without barricades. Work was stopped and the team coached on proper barricade placement to protect the testing area before work resumed."
    },
    {
