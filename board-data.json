  "safetyLog": [
    {
      "date": "Jul 31, 2026",
      "shortDesc": "📌 ADVISORY — rigging path check before crane cable-up",
      "desc": "ADVISORY — Interim, pending PSE investigation. Before cabling up with the crane, walk the full rigging path and confirm no wire rope, sling, or chain fall can catch on studs, bolting, or protruding hardware. Confirm personnel positions and exclusion zones below and adjacent to the lift before load is taken. Applies to all lifting operations at HLC. To be revised when investigation findings are issued."
    },
    {
      "date": "Jul 29, 2026",
      "shortDesc": "⚠️ PSE — dropped chain fall, 7HA.03 exhaust frame rigging",
      "desc": "ADVANCE COMMUNICATION — Potential Severe Event, investigation active. 7HA.03 crew was clearing rigging after the exhaust frame was set. While cabling up with the crane, two 3/4-inch wire ropes caught on an ITH stud between the mini case and the exhaust frame and failed. A 10T chain fall fell to the turbine deck and did not strike anyone. A signal person was tied off on top of the compressor turbine shell at the time. No injuries. Work was stopped immediately. Findings to follow."
    },
    {
      "date": "Jul 24, 2026",
      "shortDesc": "🛑 Stop Work — damaged sling caught before rotor lift",
      "desc": "7HA.03 Project Crew — Damaged sling discovered while unloading the rotor beam from the hook to the lifting beam. Sling immediately tagged out of service; no equivalent-rated sling available onsite, so a replacement was rented locally in Houston. Lift completed on schedule with no further delay."
    },
    {
      "date": "Jul 5, 2026",
      "shortDesc": "🛑 Stop Work — barricade correction, 7FH2 rotor",
      "desc": "Submitted by Ben Smith — LV 26-1 class was performing live electrical testing on the 7FH2 rotor without barricades. Work was stopped and the team coached on proper barricade placement to protect the testing area before work resumed."
    },
    {
      "date": "Apr 3, 2026",
      "shortDesc": "Lube oil spill — contained",
      "desc": "Lube oil spill during maintenance exercise — contained, cleaned, no injury"
    },
    {
      "date": "Mar 14, 2026",
      "shortDesc": "Slip — wet floor near lab",
      "desc": "Slip on wet floor near lab entrance — no injury, area secured"
    }
  ],
